# ──────────────────────────────────────────────────────────
# BrandPulse AI — Backend Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────

# ── Server ──────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ── Database ─────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/brandpulse?retryWrites=true&w=majority

# ── Security ──────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=YOUR_STRONG_RANDOM_SECRET_HERE
JWT_EXPIRES_IN=7d

# ── Gemini AI ─────────────────────────────────────────────
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# ── News API ──────────────────────────────────────────────
NEWS_API_KEY=YOUR_NEWSAPI_KEY
NEWS_API_BASE_URL=https://newsapi.org/v2

# ── CORS ──────────────────────────────────────────────────
# Set to your Vercel frontend URL in production
FRONTEND_URL=https://your-app.vercel.app

# ── Email / SMTP ──────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=youremail@gmail.com
# Use a Gmail App Password (not your login password)
SMTP_PASS=YOUR_16_CHARACTER_GMAIL_APP_PASSWORD
EMAIL_FROM=youremail@gmail.com
