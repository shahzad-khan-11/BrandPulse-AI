# ──────────────────────────────────────────────────────────
# BrandPulse AI — .gitignore
# ──────────────────────────────────────────────────────────

# ── Dependencies ─────────────────────────────────────────
node_modules/
**/node_modules/

# ── Environment & Secrets (NEVER COMMIT) ─────────────────
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
**/.env
**/.env.*
!**/.env.example

# ── Build Outputs ─────────────────────────────────────────
dist/
**/dist/
build/
**/build/

# ── Logs ──────────────────────────────────────────────────
logs/
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Lock Files (optional — remove if you want to commit them) ─
package-lock.json
**/package-lock.json
yarn.lock
**/yarn.lock
pnpm-lock.yaml
**/pnpm-lock.yaml

# ── Uploads (user-generated content, not for git) ─────────
backend/uploads/
!backend/uploads/.gitkeep

# ── IDE & OS Files ─────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
desktop.ini

# ── TypeScript ────────────────────────────────────────────
*.tsbuildinfo

# ── Coverage ──────────────────────────────────────────────
coverage/
.nyc_output/
